{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://richardham.co.uk/schemas/titr-secondbrain/claim.schema.json",
  "title": "TITR SecondBrain claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "status",
    "classification",
    "source_ids",
    "confidence",
    "observed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^claim-[a-z0-9-]{3,120}$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "supported",
        "disputed",
        "approved",
        "superseded",
        "rejected"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "personal",
        "client-scoped"
      ]
    },
    "security_domain": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "verified"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
